[Unit]
Description=AntBot Unbiased Logger: Snapshot Engine
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/yesv2/callsbotonchain
Environment="REDIS_URL=redis://localhost:6379/0"
ExecStart=/usr/bin/python3 scripts/unbiased_logger/snapshot_engine.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
